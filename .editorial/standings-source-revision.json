{
  "authorizedAt": "2026-10-12",
  "authorization": "Owner approved the Standings source-notice proposal in this session.",
  "beforeText": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <title>TV96 Live - League Standings</title>\r\n\r\n    <meta name=\"google-adsense-account\" content=\"ca-pub-9924964891667864\">\r\n    <meta name=\"description\" content=\"View current football league standings and tables on TV96 Live.\">\r\n    <meta property=\"og:url\" content=\"https://www.tv96live.org/standings\">\r\n    <link rel=\"canonical\" href=\"https://www.tv96live.org/standings\">\r\n\r\n    <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\">\r\n\r\n    <link rel=\"stylesheet\"\r\n          href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css\">\r\n\r\n    <link rel=\"stylesheet\" href=\"style.css?v=2\">\r\n    <link rel=\"stylesheet\" href=\"site-chrome.css?v=1\">\r\n    <script defer src=\"site-header.js\"></script>\r\n\r\n    <script async src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9924964891667864\"\r\n            crossorigin=\"anonymous\"></script>\r\n\r\n    <style>\r\n\r\n        /* ==========================================\r\n           STANDINGS PAGE\r\n        ========================================== */\r\n\r\n        .standings-page {\r\n            width: 100%;\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n\r\n        .standings-layout {\r\n            display: grid;\r\n            grid-template-columns: minmax(0, 1fr) 300px;\r\n            gap: 30px;\r\n            max-width: 1300px;\r\n            margin: 30px auto;\r\n            padding: 0 20px;\r\n        }\r\n\r\n        .standings-sidebar .sidebar-widget {\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           TOP HEADER\r\n        ========================================== */\r\n\r\n        .standings-header {\r\n            background: var(--card-bg, #08232d);\r\n            border-radius: 16px;\r\n            padding: 20px;\r\n\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n\r\n            gap: 20px;\r\n            margin-bottom: 20px;\r\n\r\n            border: 1px solid rgba(16, 185, 129, 0.25);\r\n        }\r\n\r\n\r\n        .league-title-box {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 15px;\r\n        }\r\n\r\n\r\n        .league-title-box img {\r\n            width: 55px;\r\n            height: 55px;\r\n            object-fit: contain;\r\n\r\n            background: white;\r\n            padding: 5px;\r\n            border-radius: 10px;\r\n        }\r\n\r\n\r\n        .league-title-box h1 {\r\n            margin: 0;\r\n            font-size: 24px;\r\n            color: #ffffff;\r\n        }\r\n\r\n\r\n        .league-title-box p {\r\n            margin: 4px 0 0;\r\n            font-size: 13px;\r\n            color: #9ca3af;\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           BACK BUTTON\r\n        ========================================== */\r\n\r\n        .back-button {\r\n            display: inline-flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n\r\n            padding: 9px 14px;\r\n\r\n            background: #10b981;\r\n            color: white;\r\n\r\n            border-radius: 8px;\r\n\r\n            text-decoration: none !important;\r\n\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n\r\n            transition: 0.25s ease;\r\n        }\r\n\r\n\r\n        .back-button:hover {\r\n            background: #059669;\r\n            transform: translateY(-1px);\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           TABLE\r\n        ========================================== */\r\n\r\n        .standings-card {\r\n            background: var(--card-bg, #08232d);\r\n\r\n            border-radius: 16px;\r\n\r\n            overflow: hidden;\r\n\r\n            border: 1px solid rgba(255, 255, 255, 0.08);\r\n        }\r\n\r\n\r\n        .standings-table-wrapper {\r\n            width: 100%;\r\n            overflow-x: auto;\r\n        }\r\n\r\n\r\n        .standings-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            min-width: 650px;\r\n        }\r\n\r\n\r\n        .standings-table thead {\r\n            background: rgba(16, 185, 129, 0.12);\r\n        }\r\n\r\n\r\n        .standings-table th {\r\n            padding: 13px 10px;\r\n\r\n            font-size: 12px;\r\n            font-weight: 700;\r\n\r\n            color: #10b981;\r\n\r\n            text-align: center;\r\n\r\n            white-space: nowrap;\r\n        }\r\n\r\n\r\n        .standings-table th:nth-child(2) {\r\n            text-align: left;\r\n        }\r\n\r\n\r\n        .standings-table td {\r\n            padding: 12px 10px;\r\n\r\n            border-top: 1px solid rgba(255, 255, 255, 0.06);\r\n\r\n            text-align: center;\r\n\r\n            font-size: 13px;\r\n\r\n            color: #e5e7eb;\r\n        }\r\n\r\n\r\n        .standings-table td:nth-child(2) {\r\n            text-align: left;\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           TEAM\r\n        ========================================== */\r\n\r\n        .team-cell {\r\n            display: flex;\r\n            align-items: center;\r\n\r\n            gap: 10px;\r\n\r\n            font-weight: 600;\r\n        }\r\n\r\n\r\n        .team-logo {\r\n            width: 30px;\r\n            height: 30px;\r\n\r\n            object-fit: contain;\r\n\r\n            flex-shrink: 0;\r\n        }\r\n\r\n\r\n        .position {\r\n            width: 45px;\r\n            font-weight: 800;\r\n        }\r\n\r\n\r\n        .points {\r\n            font-weight: 800;\r\n            color: #10b981;\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           FORM\r\n        ========================================== */\r\n\r\n        .form {\r\n            display: flex;\r\n            justify-content: center;\r\n            gap: 4px;\r\n        }\r\n\r\n\r\n        .form span {\r\n            width: 19px;\r\n            height: 19px;\r\n\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n\r\n            border-radius: 4px;\r\n\r\n            font-size: 10px;\r\n            font-weight: 800;\r\n        }\r\n\r\n\r\n        .form-win {\r\n            background: #16a34a;\r\n            color: white;\r\n        }\r\n\r\n\r\n        .form-draw {\r\n            background: #f59e0b;\r\n            color: white;\r\n        }\r\n\r\n\r\n        .form-loss {\r\n            background: #dc2626;\r\n            color: white;\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           POSITION COLORS\r\n        ========================================== */\r\n\r\n        .standings-table tbody tr.champions td:first-child {\r\n            border-left: 4px solid #2563eb;\r\n        }\r\n\r\n\r\n        .standings-table tbody tr.champions-qualifier td:first-child {\r\n            border-left: 4px solid #06b6d4;\r\n        }\r\n\r\n\r\n        .standings-table tbody tr.europa td:first-child {\r\n            border-left: 4px solid #f59e0b;\r\n        }\r\n\r\n\r\n        .standings-table tbody tr.conference td:first-child {\r\n            border-left: 4px solid #22c55e;\r\n        }\r\n\r\n\r\n        .standings-table tbody tr.relegation-playoff td:first-child {\r\n            border-left: 4px solid #facc15;\r\n        }\r\n\r\n\r\n        .standings-table tbody tr.relegation td:first-child {\r\n            border-left: 4px solid #dc2626;\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           LIGHT MODE\r\n        ========================================== */\r\n\r\n        body.light-mode .standings-header,\r\n        body.light-mode .standings-card {\r\n            background: #ffffff;\r\n            border-color: #e5e7eb;\r\n        }\r\n\r\n\r\n        body.light-mode .league-title-box h1 {\r\n            color: #111827;\r\n        }\r\n\r\n\r\n        body.light-mode .standings-table td {\r\n            color: #374151;\r\n            border-top-color: #e5e7eb;\r\n        }\r\n\r\n\r\n        body.light-mode .standings-table thead {\r\n            background: #f0fdf4;\r\n        }\r\n\r\n\r\n        @media (max-width: 900px) {\r\n            .standings-layout {\r\n                grid-template-columns: 1fr;\r\n            }\r\n        }\r\n\r\n\r\n        /* ==========================================\r\n           MOBILE\r\n        ========================================== */\r\n\r\n        @media (max-width: 600px) {\r\n\r\n            body {\r\n                overflow-x: hidden;\r\n            }\r\n\r\n            .standings-layout {\r\n                grid-template-columns: 1fr;\r\n                margin: 20px auto;\r\n                padding: 0 10px;\r\n            }\r\n\r\n            .standings-page {\r\n                margin: 0;\r\n                padding: 0;\r\n            }\r\n\r\n\r\n            .standings-header {\r\n                padding: 14px;\r\n                border-radius: 12px;\r\n\r\n                align-items: flex-start;\r\n                gap: 10px;\r\n            }\r\n\r\n\r\n            .league-title-box {\r\n                gap: 10px;\r\n                min-width: 0;\r\n            }\r\n\r\n\r\n            .league-title-box img {\r\n                width: 42px;\r\n                height: 42px;\r\n            }\r\n\r\n\r\n            .league-title-box h1 {\r\n                font-size: 18px;\r\n                line-height: 1.2;\r\n            }\r\n\r\n\r\n            .league-title-box p {\r\n                font-size: 11px;\r\n            }\r\n\r\n\r\n            .back-button {\r\n                padding: 8px 10px;\r\n                font-size: 11px;\r\n                flex-shrink: 0;\r\n            }\r\n\r\n\r\n            .standings-card {\r\n                border-radius: 12px;\r\n            }\r\n\r\n\r\n            .standings-table {\r\n                min-width: 0;\r\n            }\r\n\r\n\r\n            .standings-table th,\r\n            .standings-table td {\r\n                padding: 9px 7px;\r\n                font-size: 11px;\r\n            }\r\n\r\n            /* On mobile, show only position, team, P, GD and Pts. */\r\n            .standings-table th:nth-child(4),\r\n            .standings-table td:nth-child(4),\r\n            .standings-table th:nth-child(5),\r\n            .standings-table td:nth-child(5),\r\n            .standings-table th:nth-child(6),\r\n            .standings-table td:nth-child(6),\r\n            .standings-table th:nth-child(7),\r\n            .standings-table td:nth-child(7),\r\n            .standings-table th:nth-child(8),\r\n            .standings-table td:nth-child(8),\r\n            .standings-table th:nth-child(11),\r\n            .standings-table td:nth-child(11) {\r\n                display: none;\r\n            }\r\n\r\n            .team-cell {\r\n                gap: 6px;\r\n                min-width: 110px;\r\n            }\r\n\r\n\r\n            .team-logo {\r\n                width: 25px;\r\n                height: 25px;\r\n            }\r\n\r\n        }\r\n\r\n    </style>\r\n    <script defer src=\"https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js\"></script>\r\n<style>.data-context { margin: 24px 0; padding: 20px; border: 1px solid var(--border-color, #777); border-radius: 12px; color: var(--text-primary); background: var(--bg-secondary); line-height: 1.7; overflow-wrap: anywhere; } .data-context h2 { font-size: 1.25rem; margin: 0 0 12px; } .data-context p { margin: 10px 0; } .data-context a { color: var(--accent-color, #16855e); text-decoration: underline; } .data-context dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; } .data-context dt { font-weight: 700; } .data-context dd { margin: 0; }</style>\r\n</head>\r\n\r\n\r\n<body class=\"standings-page-body\">\r\n\r\n    <header class=\"main-header\">\r\n        <div class=\"navbar-container\">\r\n            <div class=\"logo\">\r\n            <a href=\"/\">\r\n                <img src=\"/logo/Logo.png\" alt=\"TV96 Live Logo\">\r\n            </a>\r\n            </div><button class=\"menu-icon\" id=\"menuToggle\" type=\"button\" aria-label=\"Open navigation menu\" aria-controls=\"navMenu\" aria-expanded=\"false\"><i class=\"fas fa-bars\" aria-hidden=\"true\"></i></button>\r\n            <nav class=\"nav-menu\" id=\"navMenu\">\r\n            <a href=\"/\" class=\"nav-link\">Home</a>\r\n            <a href=\"/matches\" class=\"nav-link\">Matches</a>\r\n            <a href=\"/news\" class=\"nav-link\">Latest News</a>\r\n            <a href=\"/about\" class=\"nav-link\">About Us</a>\r\n            <a href=\"/privacy\" class=\"nav-link\">Privacy</a>\r\n            </nav>\r\n            <div class=\"header-right\">\r\n            <button id=\"installBtn\" class=\"btn-primary header-install-btn\" hidden>Install App</button>\r\n            <div class=\"social-icons\">\r\n            <a href=\"https://www.facebook.com/share/1EVaiqB9sZ/\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Facebook\"> <i data-lucide=\"facebook\"></i> </a>\r\n            <a href=\"https://www.tiktok.com/@user242901873?_r=1&_t=ZS-97lGYrPehTp\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"TikTok\" aria-label=\"TikTok\"><i class=\"fa-brands fa-tiktok\"></i></a>\r\n            <a href=\"https://www.youtube.com/channel/UC1UYBGeLGdB7O59qImRAGrg\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"YouTube\"> <i data-lucide=\"youtube\"></i> </a>\r\n            </div>\r\n            <button class=\"theme-toggle\" id=\"themeToggle\" type=\"button\" title=\"Switch Theme\" aria-label=\"Switch theme\">\r\n            <i data-lucide=\"moon\"></i>\r\n            </button>\r\n            </div>\r\n        </div>\r\n    </header>\r\n\r\n    <!-- ==========================================\r\n         MAIN\r\n    ========================================== -->\r\n\r\n    <div class=\"standings-layout\">\r\n    <main class=\"standings-page\">\r\n\r\n\r\n        <!-- HEADER -->\r\n\r\n        <div class=\"standings-header\">\r\n\r\n            <div class=\"league-title-box\">\r\n\r\n                <img\r\n                    id=\"leagueLogo\"\r\n                    src=\"\"\r\n                    alt=\"League Logo\"\r\n                >\r\n\r\n                <div>\r\n\r\n                    <h1 id=\"leagueName\">\r\n                        League Standings\r\n                    </h1>\r\n\r\n                    <p id=\"seasonName\">\r\n                        2026/27 Season\r\n                    </p>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <a href=\"/matches\" class=\"back-button\">\r\n\r\n                <i class=\"fa-solid fa-arrow-left\"></i>\r\n\r\n                Back\r\n\r\n            </a>\r\n\r\n        </div>\r\n\r\n\r\n        <!-- TABLE -->\r\n\r\n        <div class=\"standings-card\">\r\n\r\n            <div class=\"standings-table-wrapper\">\r\n\r\n                <table class=\"standings-table\">\r\n\r\n                    <thead>\r\n\r\n                        <tr>\r\n\r\n                            <th>#</th>\r\n\r\n                            <th>Team</th>\r\n\r\n                            <th>P</th>\r\n\r\n                            <th>W</th>\r\n\r\n                            <th>D</th>\r\n\r\n                            <th>L</th>\r\n\r\n                            <th>GF</th>\r\n\r\n                            <th>GA</th>\r\n\r\n                            <th>GD</th>\r\n\r\n                            <th>Pts</th>\r\n\r\n                            <th>Form</th>\r\n\r\n                        </tr>\r\n\r\n                    </thead>\r\n\r\n\r\n                    <tbody id=\"standingsBody\"></tbody>\r\n\r\n                </table>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <section class=\"data-context\" aria-labelledby=\"table-guide-heading\">\r\n            <h2 id=\"table-guide-heading\">Reading this table</h2>\r\n            <dl><dt>P</dt><dd>Matches played.</dd><dt>W / D / L</dt><dd>Wins, draws and losses.</dd><dt>GF / GA</dt><dd>Goals scored and goals conceded.</dd><dt>GD</dt><dd>Goal difference: GF minus GA.</dd><dt>Pts</dt><dd>League points. Three for a win and one for a draw; official adjustments can change the total.</dd></dl>\r\n            <p>Position colours are indicative guides. European places can change with cup winners, title holders and season-specific allocations; relegation and play-off rules also vary by competition. A highlighted position is not confirmation of qualification or relegation. See the <a href=\"/articles/19\">European qualification guide</a> and <a href=\"/articles/15\">tiebreaker explanation</a>.</p>\r\n            <p>Tables depend on football-data.org and may lag completed matches. An empty or failed response cannot establish a club's position. Reload later, select another competition, or check the official league table before treating an outcome as final.</p>\r\n            <p>League guides: <a href=\"/articles/12\">Premier League</a>, <a href=\"/articles/21\">La Liga</a>, <a href=\"/articles/22\">Serie A</a>, <a href=\"/articles/23\">Bundesliga</a>, <a href=\"/articles/24\">Ligue 1</a> and <a href=\"/articles/14\">Champions League</a>.</p>\r\n        </section>\r\n    </main>\r\n\r\n        <aside class=\"content-sidebar standings-sidebar\">\r\n            <!-- Trending News Widget -->\r\n            <div class=\"sidebar-widget\">\r\n                <h3 class=\"widget-title\" style=\"font-size: 16px; font-weight: 800; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 2px solid var(--primary-green);\">\r\n                    <i class=\"fa-solid fa-fire\"></i> Trending News\r\n                </h3>\r\n                <ul class=\"trending-list\" id=\"trending-list\" style=\"list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;\"></ul>\r\n            </div>\r\n\r\n            <!-- Trending Matches Widget -->\r\n            <div class=\"sidebar-widget\">\r\n                <h3 class=\"widget-title\" style=\"font-size: 16px; font-weight: 800; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 2px solid var(--primary-green);\">\r\n                    <i class=\"fa-solid fa-futbol\"></i> Trending Matches\r\n                </h3>\r\n                <ul class=\"trending-matches-list\"></ul>\r\n            </div>\r\n        </aside>\r\n    </div>\r\n\r\n    <footer class=\"main-footer\">\r\n   <div class=\"footer-container\">\r\n    <div class=\"footer-col about-col\"><a href=\"/\" aria-label=\"TV96 Live home\"><img src=\"/logo/Logo.png\" alt=\"TV96 Live Logo\" class=\"footer-logo\"></a>\r\n     <p>Football news, fixtures, standings and match updates for fans worldwide.</p>\r\n    </div>\r\n    <div class=\"footer-col links-col\">\r\n     <h4>Quick Links</h4>\r\n     <ul>\r\n      <li><a href=\"/\">Home</a></li>\r\n      <li><a href=\"/matches\">Matches</a></li>\r\n      <li><a href=\"/news\">News</a></li>\r\n      <li><a href=\"/about\">About</a></li>\r\n      <li><a href=\"/contact\">Contact</a></li>\r\n      <li><a href=\"/privacy\">Privacy Policy</a></li>\r\n      <li><a href=\"/terms\">Terms of Use</a></li>\r\n     </ul>\r\n    </div>\r\n    <div class=\"footer-col social-col\">\r\n     <h4>Contact Us</h4>\r\n     <div class=\"footer-social-links\">\r\n      <a href=\"https://www.facebook.com/share/1EVaiqB9sZ/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Facebook\"><i data-lucide=\"facebook\"></i></a>\r\n      <a href=\"https://www.tiktok.com/@user242901873?_r=1&_t=ZS-97lGYrPehTp\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"TikTok\"><i class=\"fa-brands fa-tiktok\"></i></a>\r\n      <a href=\"https://www.youtube.com/channel/UC1UYBGeLGdB7O59qImRAGrg\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"YouTube\"><i data-lucide=\"youtube\"></i></a>\r\n     </div>\r\n    </div>\r\n   </div>\r\n   <div class=\"footer-bottom\">\r\n    <p>© 2026 <a href=\"https://www.tv96live.org\" class=\"hover:text-emerald-500 transition-colors\">www.tv96live.org</a> - All rights reserved.</p>\r\n   </div>\r\n  </footer>\r\n\r\n\r\n<script src=\"/site-config.js\"></script>\r\n<script>\r\n\r\n\r\n// ======================================================\r\n// AUTOMATIC STANDINGS\r\n// ======================================================\r\n\r\nconst leagueCodes = Object.freeze({\r\n    \"Premier League\": \"PL\",\r\n    \"La Liga\": \"PD\",\r\n    \"Serie A\": \"SA\",\r\n    \"Bundesliga\": \"BL1\",\r\n    \"Ligue 1\": \"FL1\",\r\n    \"UEFA Champions League\": \"CL\",\r\n    \"Champions League\": \"CL\"\r\n});\r\n\r\nconst params = new URLSearchParams(window.location.search);\r\nconst selectedLeague = params.get(\"league\") || \"Premier League\";\r\n\r\nfunction escapeHtml(value) {\r\n    return String(value ?? \"\").replace(/[&<>'\"]/g, character => ({\r\n        \"&\": \"&amp;\",\r\n        \"<\": \"&lt;\",\r\n        \">\": \"&gt;\",\r\n        \"'\": \"&#39;\",\r\n        \"\\\"\": \"&quot;\"\r\n    })[character]);\r\n}\r\n\r\nfunction showTableMessage(tbody, message) {\r\n    tbody.innerHTML = `\r\n        <tr>\r\n            <td colspan=\"11\" style=\"padding:40px;text-align:center;\">\r\n                ${escapeHtml(message)}\r\n            </td>\r\n        </tr>\r\n    `;\r\n}\r\n\r\nfunction formatSeason(season) {\r\n    if (!season?.startDate || !season?.endDate) {\r\n        return \"Current season\";\r\n    }\r\n\r\n    const startYear = new Date(season.startDate).getUTCFullYear();\r\n    const endYear = new Date(season.endDate).getUTCFullYear();\r\n\r\n    if (!Number.isFinite(startYear) || !Number.isFinite(endYear)) {\r\n        return \"Current season\";\r\n    }\r\n\r\n    return `${startYear}/${String(endYear).slice(-2)} Season`;\r\n}\r\n\r\nfunction formatForm(form) {\r\n    const rawForm = Array.isArray(form)\r\n        ? form\r\n        : String(form || \"\").trim();\r\n\r\n    const formResults = (Array.isArray(rawForm)\r\n        ? rawForm\r\n        : rawForm.includes(\",\")\r\n            ? rawForm.split(\",\")\r\n            : rawForm.split(\"\")\r\n    )\r\n        .map(result => String(result).trim().toUpperCase())\r\n        .filter(result => [\"W\", \"D\", \"L\"].includes(result))\r\n        .slice(-5);\r\n\r\n    return formResults.map(result => {\r\n        const formClass = result === \"W\"\r\n            ? \"form-win\"\r\n            : result === \"D\"\r\n                ? \"form-draw\"\r\n                : \"form-loss\";\r\n\r\n        return `<span class=\"${formClass}\">${escapeHtml(result)}</span>`;\r\n    }).join(\"\");\r\n}\r\n\r\nconst leaguePositionRules = Object.freeze({\r\n    PL: [\r\n        { positions: [1, 4], className: \"champions\", label: \"Champions League\" },\r\n        { positions: [5, 5], className: \"europa\", label: \"Europa League\" },\r\n        { positions: [6, 6], className: \"conference\", label: \"Conference League qualification\" },\r\n        { positions: [18, 20], className: \"relegation\", label: \"Relegation\" }\r\n    ],\r\n    PD: [\r\n        { positions: [1, 4], className: \"champions\", label: \"Champions League\" },\r\n        { positions: [5, 5], className: \"europa\", label: \"Europa League\" },\r\n        { positions: [6, 6], className: \"conference\", label: \"Conference League qualification\" },\r\n        { positions: [18, 20], className: \"relegation\", label: \"Relegation\" }\r\n    ],\r\n    SA: [\r\n        { positions: [1, 4], className: \"champions\", label: \"Champions League\" },\r\n        { positions: [5, 5], className: \"europa\", label: \"Europa League\" },\r\n        { positions: [6, 6], className: \"conference\", label: \"Conference League qualification\" },\r\n        { positions: [18, 20], className: \"relegation\", label: \"Relegation\" }\r\n    ],\r\n    BL1: [\r\n        { positions: [1, 4], className: \"champions\", label: \"Champions League\" },\r\n        { positions: [5, 5], className: \"europa\", label: \"Europa League\" },\r\n        { positions: [6, 6], className: \"conference\", label: \"Conference League qualification\" },\r\n        { positions: [16, 16], className: \"relegation-playoff\", label: \"Relegation Playoff\" },\r\n        { positions: [17, 18], className: \"relegation\", label: \"Relegation\" }\r\n    ],\r\n    FL1: [\r\n        { positions: [1, 3], className: \"champions\", label: \"Champions League\" },\r\n        { positions: [4, 4], className: \"champions-qualifier\", label: \"Champions League Qualifying\" },\r\n        { positions: [5, 5], className: \"europa\", label: \"Europa League\" },\r\n        { positions: [6, 6], className: \"conference\", label: \"Conference League qualification\" },\r\n        { positions: [16, 16], className: \"relegation-playoff\", label: \"Relegation Playoff\" },\r\n        { positions: [17, 18], className: \"relegation\", label: \"Relegation\" }\r\n    ]\r\n});\r\n\r\nfunction getPositionClass(leagueCode, position, totalTeams) {\r\n    if (!Number.isInteger(position) || position < 1 || position > totalTeams) {\r\n        return \"\";\r\n    }\r\n\r\n    const rule = (leaguePositionRules[leagueCode] || []).find(({ positions }) => (\r\n        position >= positions[0] && position <= positions[1]\r\n    ));\r\n\r\n    return rule?.className || \"\";\r\n}\r\n\r\nlet standingsRequestInFlight = false;\r\n\r\nasync function loadStandings(showLoading = true) {\r\n    if (standingsRequestInFlight) {\r\n        return;\r\n    }\r\n\r\n    const leagueName = document.getElementById(\"leagueName\");\r\n    const leagueLogo = document.getElementById(\"leagueLogo\");\r\n    const seasonName = document.getElementById(\"seasonName\");\r\n    const tbody = document.getElementById(\"standingsBody\");\r\n    const leagueCode = leagueCodes[selectedLeague];\r\n\r\n    leagueName.textContent = selectedLeague;\r\n    seasonName.textContent = \"Current season\";\r\n    leagueLogo.style.display = \"none\";\r\n\r\n    if (!leagueCode) {\r\n        showTableMessage(tbody, `Automatic standings are not available for ${selectedLeague}. Choose a supported competition from the league links.`);\r\n        return;\r\n    }\r\n\r\n    if (showLoading) {\r\n        showTableMessage(tbody, \"Loading standings...\");\r\n    }\r\n\r\n    standingsRequestInFlight = true;\r\n\r\n    try {\r\n        const response = await fetch(`/api/standings?league=${encodeURIComponent(leagueCode)}`);\r\n        const payload = await response.json().catch(() => null);\r\n\r\n        if (!response.ok) {\r\n            const message = payload?.error || \"Could not load standings right now.\";\r\n            const requestError = new Error(message);\r\n            requestError.status = response.status;\r\n            throw requestError;\r\n        }\r\n\r\n        if (!payload || !Array.isArray(payload.standings) || payload.standings.length === 0) {\r\n            throw new Error(\"The provider returned no standings for this competition. Try another league or reload later.\");\r\n        }\r\n\r\n        leagueName.textContent = payload.competition?.name || selectedLeague;\r\n        seasonName.textContent = formatSeason(payload.season);\r\n\r\n        if (payload.competition?.emblem) {\r\n            leagueLogo.src = payload.competition.emblem;\r\n            leagueLogo.alt = `${leagueName.textContent} logo`;\r\n            leagueLogo.style.display = \"block\";\r\n        }\r\n\r\n        const totalTeams = payload.standings.length;\r\n        const hasSequentialApiPositions = payload.standings.every((team, index) => (\r\n            Number(team.position ?? team.rank) === index + 1\r\n        ));\r\n\r\n        tbody.innerHTML = payload.standings.map((team, index) => {\r\n            const apiPosition = Number(team.position ?? team.rank);\r\n            const position = hasSequentialApiPositions ? apiPosition : index + 1;\r\n            const positionClass = getPositionClass(leagueCode, position, totalTeams);\r\n\r\n            const crest = team.logo\r\n                ? `<img class=\"team-logo\" src=\"${escapeHtml(team.logo)}\" alt=\"${escapeHtml(team.name)} crest\" loading=\"lazy\" onerror=\"this.style.visibility='hidden'\">`\r\n                : \"\";\r\n            const form = formatForm(team.form);\r\n\r\n            return `\r\n                <tr class=\"${positionClass}\">\r\n                    <td class=\"position\">${escapeHtml(position)}</td>\r\n                    <td>\r\n                        <div class=\"team-cell\">\r\n                            ${crest}\r\n                            <span>${escapeHtml(team.name || \"Unknown team\")}</span>\r\n                        </div>\r\n                    </td>\r\n                    <td>${escapeHtml(team.played)}</td>\r\n                    <td>${escapeHtml(team.win)}</td>\r\n                    <td>${escapeHtml(team.draw)}</td>\r\n                    <td>${escapeHtml(team.lose)}</td>\r\n                    <td>${escapeHtml(team.goalsFor)}</td>\r\n                    <td>${escapeHtml(team.goalsAgainst)}</td>\r\n                    <td>${escapeHtml(team.goalDifference)}</td>\r\n                    <td class=\"points\">${escapeHtml(team.points)}</td>\r\n                    <td><div class=\"form\">${form}</div></td>\r\n                </tr>\r\n            `;\r\n        }).join(\"\");\r\n    } catch (error) {\r\n        console.error(\"[standings] Failed to load standings\", {\r\n            league: selectedLeague,\r\n            status: error.status || null,\r\n            message: error.message\r\n        });\r\n        showTableMessage(tbody, `${error.message || \"Could not load standings right now.\"} No positions can be confirmed from this response. Try another competition or reload later.`);\r\n    } finally {\r\n        standingsRequestInFlight = false;\r\n    }\r\n}\r\n\r\nloadStandings();\r\nsetInterval(() => loadStandings(false), 60000);\r\n\r\n</script>\r\n\r\n<script src=\"news-data.js\"></script>\r\n<script src=\"matches-data.js\"></script>\r\n<script>\r\n    const menuIcon = document.querySelector('.menu-icon');\r\n    const navMenu = document.querySelector('.nav-menu');\r\n\r\n    if (menuIcon && navMenu) {\r\n        menuIcon.addEventListener('click', () => navMenu.classList.toggle('active'));\r\n    }\r\n\r\n    const trendingList = document.getElementById('trending-list');\r\n    if (trendingList && typeof articles !== 'undefined') {\r\n        trendingList.innerHTML = getPublishedArticles()\r\n            .sort((a, b) => b.id - a.id)\r\n            .slice(0, 5)\r\n            .map(article => `\r\n                <li>\r\n                    <a href=\"/articles/${article.id}\" style=\"display:block; padding:10px 12px; background:rgba(255,255,255,0.04); border-radius:8px; text-decoration:none; color:var(--text-secondary); font-size:13px; font-weight:600;\">\r\n                        ${article.title}\r\n                    </a>\r\n                </li>`)\r\n            .join('');\r\n    }\r\n\r\n    const trendingMatchesList = document.querySelector('.trending-matches-list');\r\n    function renderTrendingMatches() {\r\n        if (!trendingMatchesList) return;\r\n\r\n        const allTodayMatches = typeof matchesData !== 'undefined' ? matchesData.maanta : [];\r\n        const upcomingMatches = allTodayMatches\r\n            .filter(match => match.status === 'Upcoming')\r\n            .slice(0, 5);\r\n\r\n        trendingMatchesList.innerHTML = upcomingMatches.length\r\n            ? upcomingMatches.map(match => {\r\n                const url = match.url\r\n                    ? match.url.replace(/^\\/?watch-live\\.html(?=\\?|$)/, '/watch-live')\r\n                    : `/watch-live?id=${encodeURIComponent(match.id)}`;\r\n                const cardTag = window.TV96_CONFIG.STREAMING_ENABLED ? 'a' : 'div';\r\n                const destination = window.TV96_CONFIG.STREAMING_ENABLED ? `href=\"${url}\"` : '';\r\n                return `<li><${cardTag} ${destination}><div class=\"trending-match-teams\"><strong>${match.home} vs ${match.away}</strong></div><div class=\"trending-match-info\"><span>${match.league}</span><span>${match.displayTime}</span></div></${cardTag}></li>`;\r\n            }).join('')\r\n            : '<li style=\"color:var(--text-secondary); padding:10px;\">No upcoming matches today.</li>';\r\n    }\r\n\r\n    if (window.matchesDataReady) {\r\n        window.matchesDataReady.then(renderTrendingMatches);\r\n    } else {\r\n        renderTrendingMatches();\r\n    }\r\n</script>\r\n\r\n</body>\r\n</html>\r\n",
